{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Strawberry Agent",
  "version": "0.1.0",
  "identifier": "com.strawberry.agent",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Strawberry Agent",
        "label": "main",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": true,
        "backgroundColor": "#0E0B0D",
        "visible": false,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; frame-src 'self' https: http: data: blob:; child-src 'self' https: http: blob:",
      "assetProtocol": {
        "enable": true,
        "scope": { "allow": ["**"], "deny": [] }
      }
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "A fast, bloat-free coding harness",
    "longDescription": "Strawberry Agent is a keyboard-native coding harness for OpenRouter models, with a built-in terminal, SSH, file tools and long-running agent runs.",
    "copyright": "",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": { "depends": [] }
    },
    "windows": {
      "nsis": { "installMode": "perMachine" }
    }
  },
  "plugins": {}
}
